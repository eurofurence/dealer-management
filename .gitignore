# Allow any dev to add some local-only files
*.local
*.local/
*.local.*
*.local.*/

# Never commit logs by accident
*.log
*debug.log*
*error.log*

# WSL/NTFS
.$*
# MacOS
.DS_Store

# IDEs
.idea/
.vscode/

